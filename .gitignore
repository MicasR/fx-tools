.claude/

# MT5 compiled binaries
*.ex5

# MetaEditor backups and temp files
*.bak
*.tmp
*.log

# MT5 indicator/EA settings files (may contain API keys or credentials)
*.set
# ...except the CrossKing leg presets: pure strategy params, no credentials.
!ExpertAdvisors/CrossKing_EA/presets/*.set

# Python
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm

# secrets (NEVER commit)
terminals.xlsx
vps.txt
.env
*.secret
secrets/
~$*
orchestrator/terminals.json
