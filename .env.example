# Copy to ".env" (gitignored) and fill in. Used by the Telegram bot (§7) and reconcile.py.
# Get TELEGRAM_TOKEN from @BotFather (/newbot). Get TELEGRAM_CHAT_ID by messaging the bot once
# then opening https://api.telegram.org/bot<token>/getUpdates and reading chat.id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ORCH_URL=http://127.0.0.1:8800

# Dashboard login for remote access, e.g. from your phone. If BOTH are set, remote access requires
# signing in at /login (session cookie); the EA/watchdog/bot endpoints stay VPS-local regardless.
# Left blank -> the dashboard is reachable only from the VPS itself (localhost).
DASH_USER=
DASH_PASS=
